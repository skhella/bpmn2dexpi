<!DOCTYPE xsd [
<!ENTITY leading-identifier-char '[A-Za-z_]'>
<!ENTITY following-identifier-char '[A-Za-z_0-9]'>
<!ENTITY name-pattern '(&leading-identifier-char;&following-identifier-char;*)'>
<!ENTITY name-reference-pattern '(&name-pattern;?/&name-pattern;(\.&name-pattern;)*)'>
<!ENTITY name-references-pattern '(&name-reference-pattern;( &name-reference-pattern;)*)'>
<!ENTITY name-or-name-reference-pattern '(&name-pattern;)|(&name-reference-pattern;)'>
<!ENTITY names-pattern '(&name-pattern;( &name-pattern;)*)'>
<!ENTITY id-pattern '(&leading-identifier-char;&following-identifier-char;*)'>
<!ENTITY id-reference-pattern '(#&id-pattern;)'>
<!ENTITY name-or-id-reference-pattern '(&name-reference-pattern;|&id-reference-pattern;)'>
<!ENTITY name-or-id-references-pattern '(&name-or-id-reference-pattern;( &name-or-id-reference-pattern;)*)'>
]>
<xsd:schema version="1.1.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
